# ---------------------------------------------------------------------------
# Inua360 environment template. Copy to .env and fill locally. NEVER commit .env.
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database -------------------------------------------------------------------
# The running app must connect as inua_app (non-owner, no BYPASSRLS).
DB_HOST=localhost
DB_PORT=5432
# Host port for docker-compose Postgres; change if 5432 is already in use.
POSTGRES_PORT=5432
DB_NAME=inua360
DB_USER=inua_app
DB_PASSWORD=inua_app_dev_password
# Used only by migrations/bootstrap. The migrator owns the tables.
DB_MIGRATOR_USER=inua_migrator
DB_MIGRATOR_PASSWORD=inua_migrator_dev_password
# Supabase: set DB_HOST to the pooler/direct host, DB_PORT=5432 (direct) for
# migrations; the app may use the session-mode pooler. See docs/DECISIONS.md.
DB_SSLMODE=prefer

# Cookies / CORS -------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
# Host port for the docker-compose frontend; keep FRONTEND_ORIGIN in sync.
FRONTEND_PORT=3000
COOKIE_SECURE=false
CSRF_COOKIE_DOMAIN=
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# File storage (S3-compatible: Supabase Storage in prod, MinIO in dev) --------
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=inua360-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ADDRESSING_STYLE=path

# Compliance verifier: apps.compliance.verifiers.SelfReportedVerifier
COMPLIANCE_VERIFIER=apps.compliance.verifiers.SelfReportedVerifier

# Email (console in dev; SMTP in prod) ---------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@inua360.example
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Observability --------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# Statement parsing ----------------------------------------------------------
STATEMENT_MAX_BYTES=10485760
PENDING_STATEMENT_TTL_MINUTES=30

# Frontend -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
